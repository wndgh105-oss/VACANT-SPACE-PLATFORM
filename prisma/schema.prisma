generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TENANT
  LANDLORD
  PARTNER
  ADMIN
}

enum BusinessType {
  CAFE
  RETAIL
  OFFICE
  STUDY
  OTHER
}

enum ListingStatus {
  PENDING_REVIEW
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  CONTACTING
  CONFIRMED
  REJECTED
}

enum TenancyStatus {
  ACTIVE
  ENDED
  EXTENDED
  RELOCATED
}

enum QuoteLineKind {
  SPACE
  MAINTENANCE
  PACKAGE
  ITEM
  ADDON
}

model User {
  id           String        @id @default(cuid())
  // 카카오 이메일 동의가 심사 대기 중이라, 소셜 로그인 직후에는 이메일이 없을 수 있다.
  email        String?       @unique
  // 카카오로 만들어진 계정을 이메일 없이도 다시 찾을 수 있도록 카카오 고유 ID를 저장한다.
  kakaoId      String?       @unique
  passwordHash String
  name         String
  role         Role?
  phone        String?
  companyName  String?
  verified     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  listings     Listing[]     @relation("LandlordListings")
  applications Application[] @relation("TenantApplications")
  favorites    Favorite[]
  packages     EquipmentPackage[] @relation("PartnerPackages")
  tenancies    Tenancy[]     @relation("TenantTenancies")
  quotes       Quote[]       @relation("TenantQuotes")
  reviews      Review[]      @relation("AuthorReviews")
  reports      Report[]      @relation("ReporterReports")
}

model Listing {
  id                String         @id @default(cuid())
  landlordId        String
  landlord          User           @relation("LandlordListings", fields: [landlordId], references: [id])
  title             String?
  address           String
  region            String?
  lat               Float?
  lng               Float?
  area              Float
  monthlyRent       Int
  deposit           Int
  maintenanceFee    Int            @default(0)
  photos            String[]
  contractDurations Int[]
  businessTypes     BusinessType[]
  parking           Boolean        @default(false)
  powerKw           Int            @default(0)
  hasGas            Boolean        @default(false)
  hasDrain          Boolean        @default(false)
  immediateMoveIn   Boolean        @default(false)
  areaSummary       String?
  recommendedTypes  BusinessType[]
  description       String?
  status            ListingStatus  @default(OPEN)
  createdAt         DateTime       @default(now())
  applications      Application[]
  favorites         Favorite[]
  quotes            Quote[]
  tenancies         Tenancy[]
}

model EquipmentPackage {
  id             String          @id @default(cuid())
  businessType   BusinessType    @unique
  name           String
  items          String[]
  monthlyFee     Int
  description    String?
  active         Boolean         @default(true)
  partnerId      String?
  partner        User?           @relation("PartnerPackages", fields: [partnerId], references: [id])
  createdAt      DateTime        @default(now())
  equipmentItems EquipmentItem[]
}

model EquipmentItem {
  id         String           @id @default(cuid())
  packageId  String
  package    EquipmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name       String
  monthlyFee Int
  optional   Boolean          @default(true)
  sortOrder  Int              @default(0)
  quoteItems QuoteItem[]
}

model Quote {
  id             String       @id @default(cuid())
  tenantId       String?
  tenant         User?        @relation("TenantQuotes", fields: [tenantId], references: [id])
  listingId      String
  listing        Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  months         Int
  spaceTotal     Int
  maintenanceTotal Int        @default(0)
  equipmentTotal Int
  addonTotal     Int
  depositAmount  Int          @default(0)
  grandTotal     Int
  needCash       Int          @default(0)
  fullStartupCost Int         @default(0)
  savedVsFull    Int
  createdAt      DateTime     @default(now())
  lines          QuoteItem[]
  applications   Application[]
}

model QuoteItem {
  id         String         @id @default(cuid())
  quoteId    String
  quote      Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  itemId     String?
  item       EquipmentItem? @relation(fields: [itemId], references: [id])
  label      String
  monthlyFee Int
  onceFee    Int            @default(0)
  kind       QuoteLineKind
}

model Application {
  id               String            @id @default(cuid())
  listingId        String
  listing          Listing           @relation(fields: [listingId], references: [id])
  tenantId         String
  tenant           User              @relation("TenantApplications", fields: [tenantId], references: [id])
  quoteId          String?
  quote            Quote?            @relation(fields: [quoteId], references: [id])
  applicantName    String
  phone            String
  desiredDuration  Int
  desiredStartDate DateTime
  message          String?
  status           ApplicationStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  tenancies        Tenancy[]
}

model Tenancy {
  id            String            @id @default(cuid())
  listingId     String
  listing       Listing           @relation(fields: [listingId], references: [id])
  tenantId      String
  tenant        User              @relation("TenantTenancies", fields: [tenantId], references: [id])
  applicationId String?
  application   Application?      @relation(fields: [applicationId], references: [id])
  storeName     String?
  startDate     DateTime
  endDate       DateTime
  monthlyTotal  Int
  status        TenancyStatus     @default(ACTIVE)
  createdAt     DateTime          @default(now())
  teaser        RelocationTeaser?
  reviews       Review[]
}

model RelocationTeaser {
  id           String      @id @default(cuid())
  tenancyId    String      @unique
  tenancy      Tenancy     @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  slug         String      @unique
  storeName    String
  fromAddress  String
  toRegionHint String
  hintRadiusM  Int         @default(500)
  toLat        Float?
  toLng        Float?
  openDate     DateTime
  message      String?
  published    Boolean     @default(false)
  views        Int         @default(0)
  createdAt    DateTime    @default(now())
  hints        TeaserHint[]
}

model TeaserHint {
  id        String           @id @default(cuid())
  teaserId  String
  teaser    RelocationTeaser @relation(fields: [teaserId], references: [id], onDelete: Cascade)
  text      String
  emoji     String           @default("📍")
  sortOrder Int              @default(0)
}

model Review {
  id        String   @id @default(cuid())
  tenancyId String
  tenancy   Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AuthorReviews", fields: [authorId], references: [id])
  rating    Int
  body      String
  createdAt DateTime @default(now())
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("ReporterReports", fields: [reporterId], references: [id])
  targetType String
  targetId   String
  reason     String
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    User     @relation(fields: [tenantId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, listingId])
}
