# PostgreSQL 접속 문자열 (로컬 개발 기준)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rental_platform"

# NextAuth 세션 서명 키. 운영 환경에서는 반드시 교체하세요.
#   생성 예: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ── 선택 사항 ────────────────────────────────────────────────
# Node를 시스템 PATH에 두지 않은 환경에서 Playwright가 개발 서버를 띄울 때 사용할 명령
# E2E_DEV_COMMAND="C:\\path\\to\\npm.cmd run dev"

# 데모 영상 mp4 변환에 사용할 ffmpeg 경로 (미지정 시 PATH → Playwright 번들 순으로 탐색)
# FFMPEG_PATH="C:\\ffmpeg\\bin\\ffmpeg.exe"

# 데모 녹화 대상 주소 (기본값 http://localhost:3000)
# DEMO_BASE_URL="http://localhost:3000"
